NODE_ENV=production
PORT=3000
BASE_URL=https://anthonydenin.dev
ALLOWED_ORIGINS=https://anthonydenin.dev,https://www.anthonydenin.dev

DATABASE_URL=postgresql://root:password@db:5432/mydb
DB_HOST=db
DB_PORT=5432
DB_NAME=mydb
DB_USER=root
DB_PASSWORD=password
# In production the schema is managed by migrations, applied at startup.
# Set to true only to let TypeORM alter the schema from the entities instead.
DB_SYNCHRONIZE=false

REDIS_HOST=redis
REDIS_PORT=6379

DEMO_MODE=true
ENABLE_SWAGGER=false

# External services
JWT_SECRET=change-me

# First administrator, created by the seeders.
# Without ADMIN_PASSWORD a random password is generated and printed once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
STRIPE_SECRET_KEY=sk_live_change_me
PAYPAL_CLIENT_ID=paypal_live_change_me
PAYPAL_CLIENT_SECRET=paypal_live_change_me
