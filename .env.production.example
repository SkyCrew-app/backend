NODE_ENV=production
PORT=3000

# Public address of the API and of the web application.
BASE_URL=https://club.example.com
# Used in the links sent by e-mail (account activation, password reset).
FRONTEND_URL=https://club.example.com
# Origins allowed to call the API from a browser, comma separated.
ALLOWED_ORIGINS=https://club.example.com

DATABASE_URL=postgresql://skycrew:change-me@db:5432/skycrew
DB_HOST=db
DB_PORT=5432
DB_NAME=skycrew
DB_USER=skycrew
DB_PASSWORD=change-me
# In production the schema is managed by migrations, applied at startup.
# Set to true only to let TypeORM alter the schema from the entities instead.
DB_SYNCHRONIZE=false

REDIS_HOST=redis
REDIS_PORT=6379

# true makes the application read-only, for a public demonstration.
DEMO_MODE=false
ENABLE_SWAGGER=false

# Number of reverse proxies in front of the application (1 behind nginx or
# Caddy). Needed for per-client rate limits; leave empty when exposed directly.
TRUST_PROXY=1

# Signs the sessions. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me

# Creates the roles, the first administrator and the club settings when they
# do not exist yet. Existing data is never modified.
SEED_ON_START=true
# ADMIN_PASSWORD is required as long as that account does not exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Outgoing e-mail (account activation, password reset, notifications).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@club.example.com

# Optional. Without a key the feature answers that it is not configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=sandbox
OPENWEATHERMAP_API_KEY=
# API Ninjas key: aerodrome search and the weather of the dashboard. Without
# it both stay empty. It is only used by the server, never sent to browsers.
API_NINJAS_KEY=
