{
  "name": "skycrew-console",
  "version": "1.0.0",
  "private": true,
  "description": "Console du propriétaire SkyCrew : état, création, formules, suspension et mises à jour de toutes les installations de clubs",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "skycrew-console": "bin/skycrew-console.ts"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning bin/skycrew-console.ts serve",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "qrcode": "^1.5.4",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
