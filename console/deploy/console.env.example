# Settings of the SkyCrew console: /etc/skycrew-console/console.env
# (root:skycrew-console, rights 640). After a change: sudo systemctl restart skycrew-console

# The address of the console, exactly as typed in the browser (no slash at the end).
CONSOLE_PUBLIC_URL=https://console.example.fr

# Local port, behind nginx. The console only ever listens on 127.0.0.1.
CONSOLE_PORT=8090

# Its database (owner account, sessions, journal, Stripe subscriptions, operations).
CONSOLE_DB=/var/lib/skycrew-console/console.db

# Servers the console runs, separated by commas: name=local for this one,
# name=ssh:host for another one reached over SSH (see README, "Plusieurs serveurs").
CONSOLE_SERVERS=tickly-prod=local

# Signing secret of the Stripe webhook endpoint (whsec_...), see README, "Relier Stripe".
STRIPE_WEBHOOK_SECRET=

# Days between the first unpaid moment of a subscription and the suspension of its club.
STRIPE_GRACE_DAYS=14

# Sessions: closed after this many minutes without a page, and after this many hours anyway.
CONSOLE_SESSION_IDLE_MINUTES=30
CONSOLE_SESSION_MAX_HOURS=8
# A phone code given for an action is not asked again for this many minutes.
CONSOLE_ELEVATION_MINUTES=5
