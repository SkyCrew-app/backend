# Copy this file to .env and fill it in. Never commit the .env file.

# Address typed by the members, without https:// (Caddy adds HTTPS).
SITE_ADDRESS=club.example.com
# The same address as the members see it.
PUBLIC_URL=https://club.example.com

# Versions to run, as published on the releases pages.
BACKEND_VERSION=latest
FRONTEND_VERSION=latest

# Generate each of these with: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=

# First administrator. The password is only needed for the first start; the
# administrator should change it after signing in, then this line can be
# emptied.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing e-mail: account activation, password reset, notifications.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Optional features, left out when empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_MODE=sandbox
OPENWEATHERMAP_API_KEY=
# API Ninjas key (https://api-ninjas.com): aerodrome search in the profile
# and weather on the dashboard. It stays on the server.
API_NINJAS_KEY=

# Flight preparation. Where the operator publishes the navigation data
# bundles of each AIRAC cycle (navdata-2611.json.gz + .sha256); empty: drop
# them in the "navdata" volume instead. Winds aloft from DWD ICON-EU (about
# 500 MB downloaded a day); false to do without forecast winds.
NAVDATA_BUNDLE_URL=
WINDS_ALOFT_FETCH=true

# true makes the application read-only, for a public demonstration.
DEMO_MODE=false

# Plan of the club. club: everything except instruction; ecole: everything.
# The limits are the number of aircraft in service and of active members the
# plan allows; empty means no limit. All empty: everything, no limit.
SKYCREW_PLAN=
SKYCREW_MAX_AIRCRAFT=
SKYCREW_MAX_MEMBERS=
