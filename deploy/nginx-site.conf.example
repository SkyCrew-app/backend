# nginx site for SkyCrew running behind docker-compose.behind-proxy.yml.
# Replace club.example.com, enable the site, then let certbot add HTTPS:
#
#   sudo certbot --nginx -d club.example.com
#
# Everything is forwarded to the SkyCrew proxy, which sends the API paths to
# the API and the rest to the web application.
server {
    listen 80;
    listen [::]:80;
    server_name club.example.com;

    access_log /var/log/nginx/skycrew.access.log;
    error_log  /var/log/nginx/skycrew.error.log;

    # Uploads are limited to 10 files of 1 MB by the API.
    client_max_body_size 12M;

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Live notifications use a WebSocket.
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 300s;
    }
}
