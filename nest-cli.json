{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "templates/**/*",
        "outDir": "dist/"
      },
      {
        "include": "modules/flights/data/*.json",
        "watchAssets": true
      },
      {
        "include": "modules/flights/data/xplane/*.dat",
        "watchAssets": true
      }
    ],
    "deleteOutDir": true
  }
}
